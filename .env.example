# 복사해서 .env.local 로 사용하세요

# 개발: /api 요청을 넘길 백엔드 주소
VITE_PROXY_TARGET=https://nyam17.site

# 배포: 비워 두면 vercel.json 프록시(/api → nyam17.site)를 씀. 직접 호출하려면 https://nyam17.site
VITE_API_BASE_URL=

# 아직 서버에 없는 기능 API를 MSW 목업으로 대체
VITE_USE_MOCK=true

# true면 서버에 있는 API(로그인·마음 기록·캘린더 등)까지 전부 목업 — 백엔드 없이 시연할 때 (인증번호: 123456)
VITE_MOCK_AUTH=false
